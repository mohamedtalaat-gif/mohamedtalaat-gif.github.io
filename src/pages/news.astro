---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import ReadTime from '../components/ReadTime.astro';
import { yearsOf } from '../lib/posts';
import { news } from '../lib/feed';
import { kindLabel } from '../lib/news.js';

const years = yearsOf(news);
---

<Base title="News" description="Results, releases, papers, certificates, conferences, and milestones, newest first.">
  <div class="page">
    <h1>News</h1>
    <p class="page__lede">Everything with a date on this site, newest first: posts, papers, courses, conferences, and validation reports. Each item opens its page.</p>

    {years.map((y) => (
      <Section title={y} icon="calendar">
        <ul class="rows">
          {news
            .filter((a) => a.date.startsWith(y))
            .map((e) => (
              <li class="row">
                <span class="row__when">{e.date}</span>
                <div class="row__body">
                  <h3><a href={e.href}>{e.title}</a></h3>
                  <p>{e.summary}</p>
                  <p class="meta">{e.minutes ? <ReadTime minutes={e.minutes} /> : kindLabel(e)}</p>
                </div>
              </li>
            ))}
        </ul>
      </Section>
    ))}
  </div>
</Base>
