---
import Base from '../../layouts/Base.astro';
import ReportChart from '../../components/ReportChart.astro';
import { reports, sortedReports } from '../../data/reports';

export function getStaticPaths() {
  return reports.map((r) => ({ params: { slug: r.slug }, props: { report: r } }));
}
const { report: r } = Astro.props;
const i = sortedReports.findIndex((x) => x.slug === r.slug);
const next = sortedReports[i + 1];
const prev = sortedReports[i - 1];
---

<Base title={r.title} description={r.summary}>
  <div class="page">
    <p class="meta"><a href="/validation/">Model validation</a> / {r.project}, {r.date}</p>
    <h1 class="report-title">{r.title}</h1>
    <p class="page__lede">{r.summary}</p>

    <ul class="facts">
      {r.headline.map((h) => (<li><strong>{h.value}</strong><span>{h.label}</span></li>))}
    </ul>

    <figure class="report-fig">
      <ReportChart chart={r.chart} alt={r.caption} />
      <figcaption class="meta">{r.caption}</figcaption>
    </figure>

    <div class="prose">
      {r.body.map((p) => (<p>{p}</p>))}
    </div>

    <dl class="report-meta">
      <div><dt>Endpoint</dt><dd>{r.endpoints.join('; ')}</dd></div>
      <div><dt>Data</dt><dd>{r.datasets.join('; ')}</dd></div>
      <div><dt>Methods</dt><dd>{r.methods.join('; ')}</dd></div>
      <div><dt>Source</dt><dd><a href={r.source.href}>{r.source.label}</a>{r.related && <span> &middot; <a href={r.related.href}>{r.related.label}</a></span>}</dd></div>
    </dl>

    <nav class="report-nav" aria-label="Other reports">
      {prev ? <a href={`/validation/${prev.slug}/`}>Newer: {prev.title}</a> : <span></span>}
      {next ? <a href={`/validation/${next.slug}/`}>Older: {next.title}</a> : <span></span>}
    </nav>
  </div>
</Base>

<style is:global>
  .report-title { font-size: clamp(2rem, 4.2vw, 3rem); max-width: 24ch; }
  .report-fig { margin: 2.4rem 0 2.2rem; }
  .report-fig figcaption { margin-top: 0.6rem; max-width: 56ch; }
  .report-meta { margin: 2.6rem 0 0; display: grid; gap: 0; border-top: 1px solid var(--rule); max-width: 46rem; }
  .report-meta > div { display: grid; grid-template-columns: 8rem 1fr; gap: 1rem; padding: 0.8rem 0; border-bottom: 1px solid var(--rule); }
  .report-meta dt { font-family: var(--font-ui); color: var(--muted); }
  .report-meta dd { margin: 0; }
  .report-nav { display: flex; justify-content: space-between; gap: 2rem; margin-top: 3rem; font-family: var(--font-ui); }
  @media (max-width: 40rem) { .report-meta > div { grid-template-columns: 1fr; gap: 0.2rem; } .report-nav { flex-direction: column; gap: 0.8rem; } }
</style>
