---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import { sortedReports, reports, uniq } from '../../data/reports';

const counts = [
  { n: reports.length, label: 'reports', hint: 'Reports in this collection.' },
  { n: new Set(reports.map((r) => r.project)).size, label: 'studies', hint: 'Projects the reports come from: CYPMode, CEREBRO-X, and PharmAMP.' },
  { n: uniq((r) => r.methods), label: 'methods', hint: 'Distinct validation methods, meaning procedures that test a model. Modelling techniques are not counted.' },
  { n: uniq((r) => r.endpoints), label: 'endpoints', hint: 'Distinct quantities that a model predicts or a report evaluates.' },
  { n: uniq((r) => r.datasets), label: 'datasets', hint: 'Distinct data sources the reports test against.' },
];

const distinct = (pick: (r: (typeof reports)[number]) => string | string[]) => [...new Set(reports.flatMap((r) => [pick(r)].flat()))];
const lists = [
  { label: 'studies', items: distinct((r) => r.project) },
  { label: 'methods', items: distinct((r) => r.methods) },
  { label: 'endpoints', items: distinct((r) => r.endpoints) },
  { label: 'datasets', items: distinct((r) => r.datasets) },
];

const rules = [
  { name: 'Gates before results', text: 'An idea is accepted only if it beats its reference under a rule written before the run. Failed gates are published with the passed ones.' },
  { name: 'Splits that match the use', text: 'Nested cross-validation on the population that will be scored, and scaffold splits when the model will meet new chemistry, with the random-split number shown beside it.' },
  { name: 'Uncertainty on every number', text: 'Intervals, the size of the held-out set, and the fraction of censored values are reported with each estimate.' },
  { name: 'Controls that can fail', text: 'Permuted-label controls and independent data that the method was never fitted to, so that a leak or a weak metric shows up.' },
  { name: 'Regenerated from the data', text: 'Each figure here is produced from files in a public repository, and an audit rebuilds the reported numbers and compares them with the text.' },
];
---

<Base title="Model validation" description="Validation reports for my models: nested cross-validation, scaffold splits, calibration, permutation controls, and a public ledger of failed gates.">
  <div class="page">
    <h1>Model validation</h1>
    <p class="page__lede">
      Reports on how well my models hold up when they are tested on data they have not seen, written to be read next to one another.
    </p>

    <ul class="counters" aria-label="Contents of the collection">
      {counts.map((c) => (<li title={c.hint}><strong>{c.n}</strong><span>{c.label}</span></li>))}
    </ul>

    <p class="meta counters-note">Counted from the reports below by distinct name: studies are projects, methods are validation procedures, endpoints are the quantities evaluated, and datasets are the data sources tested against. The pages are built with <a href="https://github.com/mohamedtalaat-gif/validation-report-kit">validation-report-kit</a>.</p>

    <details class="counted">
      <summary>What is counted</summary>
      <dl>
        {lists.map((l) => (<><dt>{l.label} ({l.items.length})</dt><dd>{l.items.join('; ')}</dd></>))}
      </dl>
    </details>

    <Section title="Reports" icon="report">
      <ul class="rows reports">
        {sortedReports.map((r) => (
          <li class="row">
            <span class="row__when">{r.date}</span>
            <div class="row__body">
              <h3><a href={`/validation/${r.slug}/`}>{r.title}</a></h3>
              <p>{r.summary}</p>
              <p class="meta">{r.project}. {r.endpoints.join('; ')}.</p>
            </div>
          </li>
        ))}
      </ul>
    </Section>

    <Section title="What makes these comparable" icon="scales">
      <p>The reports cover different endpoints and different models. They are comparable because each one is held to the same rules.</p>
      <ul class="rows">
        {rules.map((r) => (
          <li class="row"><div class="row__body"><h3>{r.name}</h3><p>{r.text}</p></div></li>
        ))}
      </ul>
    </Section>
  </div>
</Base>

<style is:global>
  .counters { display: flex; flex-wrap: wrap; gap: 0.6rem 2.8rem; list-style: none; padding: 0; margin: 2rem 0 0.9rem; max-width: none; }
  .counters-note { margin: 0 0 0.8rem; max-width: none; }
  .counted { margin: 0 0 3rem; font-family: var(--font-ui); }
  .counted summary { cursor: pointer; color: var(--muted); }
  .counted dl { display: grid; grid-template-columns: 7rem 1fr; gap: 0.5rem 1.2rem; margin: 0.8rem 0 0; }
  .counted dt { color: var(--muted); }
  .counted dd { margin: 0; }
  .counters li { margin: 0; display: grid; }
  .counters strong { font: 600 clamp(2.2rem, 5vw, 3.4rem)/1 var(--font-ui); font-variant-numeric: tabular-nums; }
  .counters span { color: var(--muted); font-family: var(--font-ui); font-size: 1.05rem; }
  .reports .row { grid-template-columns: 7rem 1fr; }
</style>
