---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import { sortedReports, reports, uniq } from '../../data/reports';
import { datasets } from '../../data/datasets';
import { models, questions } from '../../data/validation/coverage';

const counts = [
  { n: reports.length, label: 'reports', hint: 'Reports in this collection.' },
  { n: new Set(reports.map((r) => r.project)).size, label: 'studies', hint: 'Projects the reports come from: CYPMode, CEREBRO-X, and PharmAMP.' },
  { n: uniq((r) => r.methods), label: 'methods', hint: 'Distinct validation methods, meaning procedures that test a model. Modelling techniques are not counted.' },
  { n: uniq((r) => r.endpoints), label: 'endpoints', hint: 'Distinct quantities that a model predicts or a report evaluates.' },
  { n: uniq((r) => r.datasets), label: 'datasets', hint: 'Distinct data sources the reports test against.' },
];

const distinct = (pick: (r: (typeof reports)[number]) => string | string[]) => [...new Set(reports.flatMap((r) => [pick(r)].flat()))];
const lists = [
  { label: 'studies', items: distinct((r) => r.project) },
  { label: 'methods', items: distinct((r) => r.methods) },
  { label: 'endpoints', items: distinct((r) => r.endpoints) },
  { label: 'datasets', items: distinct((r) => r.datasets) },
];

const bySlug = new Map(reports.map((r) => [r.slug, r]));
const short = (slug: string) => bySlug.get(slug)?.title ?? slug;
const usedBy = (name: string) => reports.filter((r) => r.datasets.includes(name));
const filters = [
  { id: 'project', label: 'Study', items: distinct((r) => r.project) },
  { id: 'endpoint', label: 'Endpoint', items: distinct((r) => r.endpoints) },
  { id: 'method', label: 'Method', items: distinct((r) => r.methods) },
  { id: 'dataset', label: 'Dataset', items: distinct((r) => r.datasets) },
];

const rules = [
  { name: 'Gates before results', text: 'An idea is accepted only if it beats its reference under a rule written before the run. Failed gates are published with the passed ones.' },
  { name: 'Splits that match the use', text: 'Nested cross-validation on the population that will be scored, and scaffold splits when the model will meet new chemistry, with the random-split number shown beside it.' },
  { name: 'Uncertainty on every number', text: 'Intervals, the size of the held-out set, and the fraction of censored values are reported with each estimate.' },
  { name: 'Controls that can fail', text: 'Permuted-label controls and independent data that the method was never fitted to, so that a leak or a weak metric shows up.' },
  { name: 'Regenerated from the data', text: 'Each figure here is produced from files in a public repository, and an audit rebuilds the reported numbers and compares them with the text.' },
];
---

<Base title="Model validation" description="Validation reports for my models: nested cross-validation, scaffold splits, calibration, permutation controls, and a public ledger of failed gates.">
  <div class="page">
    <h1>Model validation</h1>
    <p class="page__lede">
      Reports on how well my models hold up when they are tested on data they have not seen, written to be read next to one another.
    </p>

    <ul class="counters" aria-label="Contents of the collection">
      {counts.map((c) => (<li title={c.hint}><strong>{c.n}</strong><span>{c.label}</span></li>))}
    </ul>

    <p class="meta counters-note">Counted from the reports below by distinct name: studies are projects, methods are validation procedures, endpoints are the quantities evaluated, and datasets are the data sources tested against. The pages are built with <a href="https://github.com/mohamedtalaat-gif/validation-report-kit">validation-report-kit</a>.</p>

    <details class="counted">
      <summary>What is counted</summary>
      <dl>
        {lists.map((l) => (<><dt>{l.label} ({l.items.length})</dt><dd>{l.items.join('; ')}</dd></>))}
      </dl>
    </details>

    <Section title="Reports" icon="report">
      <div class="vfilter" data-vfilter>
        <label class="vfilter__search"><span>Search</span><input type="search" placeholder="A word of a title or a summary" data-vsearch /></label>
        {filters.map((f) => (
          <label class="vfilter__select">
            <span>{f.label}</span>
            <select data-vfilter-key={f.id}>
              <option value="">All</option>
              {f.items.map((item) => (<option value={item}>{item}</option>))}
            </select>
          </label>
        ))}
      </div>
      <p class="meta vfilter__count" aria-live="polite" data-vcount>{reports.length} of {reports.length} reports</p>
      <ul class="rows reports">
        {sortedReports.map((r) => (
          <li class="row" data-report data-project={r.project} data-endpoint={JSON.stringify(r.endpoints)} data-method={JSON.stringify(r.methods)} data-dataset={JSON.stringify(r.datasets)} data-text={`${r.title} ${r.summary}`.toLowerCase()}>
            <span class="row__when">{r.date}</span>
            <div class="row__body">
              <h3><a href={`/validation/${r.slug}/`}>{r.title}</a></h3>
              <p>{r.summary}</p>
              <p class="meta">{r.project}. {r.endpoints.join('; ')}.</p>
            </div>
          </li>
        ))}
      </ul>
    </Section>

    <Section title="What a complete validation asks" icon="scales">
      <p>A model validation is complete when it answers a fixed set of questions for each model. Each cell lists the reports that answer the question for that model; an empty cell is a question that no report here answers yet.</p>
      <div class="coverage" role="region" aria-label="Questions of a model validation against the models" tabindex="0">
        <table>
          <thead>
            <tr><th scope="col">Question</th>{models.map((m) => (<th scope="col">{m.label}</th>))}</tr>
          </thead>
          <tbody>
            {questions.map((q) => (
              <tr>
                <th scope="row"><strong>{q.question}</strong><span>{q.asks}</span></th>
                {models.map((m) => (
                  <td>
                    {(q.cells[m.id] ?? []).length ? (
                      <ul>{(q.cells[m.id] ?? []).map((slug) => (<li><a href={`/validation/${slug}/`}>{short(slug)}</a></li>))}</ul>
                    ) : (
                      <span class="coverage__none" aria-label="No report">&ndash;</span>
                    )}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Section>

    <Section title="Datasets" icon="research">
      <p>The data that the reports test against, and two sources that sit behind the models and are not tested against (no report is listed for them). The licence is the one that the source states; a licence that the sources do not state is left out.</p>
      <div class="dtable" role="region" aria-label="Datasets" tabindex="0">
        <table>
          <thead><tr><th scope="col">Dataset</th><th scope="col">Role</th><th scope="col">Size</th><th scope="col">Licence</th><th scope="col">Reports</th></tr></thead>
          <tbody>
            {datasets.map((d) => (
              <tr>
                <th scope="row"><a href={d.source.href}>{d.name}</a><span>{d.what}</span></th>
                <td>{d.role}</td>
                <td>{d.size ?? ''}</td>
                <td>{d.licence ?? ''}</td>
                <td>{usedBy(d.name).length ? (<ul>{usedBy(d.name).map((r) => (<li><a href={`/validation/${r.slug}/`}>{r.title}</a></li>))}</ul>) : ''}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Section>

    <Section title="What makes these comparable" icon="scales">
      <p>The reports cover different endpoints and different models. They are comparable because each one is held to the same rules.</p>
      <ul class="rows">
        {rules.map((r) => (
          <li class="row"><div class="row__body"><h3>{r.name}</h3><p>{r.text}</p></div></li>
        ))}
      </ul>
    </Section>
  </div>
</Base>

<script>
  import '../../scripts/validation-index.js';
</script>

<style is:global>
  .vfilter { display: flex; flex-wrap: wrap; gap: 0.8rem 1.2rem; margin: 0 0 0.6rem; font-family: var(--font-ui); }
  .vfilter label { display: grid; gap: 0.25rem; color: var(--muted); font-size: 0.95rem; }
  .vfilter select, .vfilter input { font: inherit; font-size: 1rem; color: var(--text); background: var(--panel); border: 1px solid var(--rule); border-radius: 6px; padding: 0.4rem 0.7rem; }
  .vfilter select { max-width: 17rem; }
  .vfilter input { min-width: 15rem; }
  .vfilter__count { margin: 0 0 0.8rem; }
  .reports .row[hidden] { display: none; }
  .sec__body { min-width: 0; }
  .coverage, .dtable { margin: 1.2rem 0 0; max-width: 100%; overflow-x: auto; border: 1px solid var(--rule); border-radius: 6px; }
  .coverage table, .dtable table { border-collapse: collapse; width: 100%; font-size: 0.95rem; }
  .coverage th, .coverage td, .dtable th, .dtable td { padding: 0.7rem 0.9rem; text-align: left; vertical-align: top; border-bottom: 1px solid var(--rule); }
  .coverage thead th, .dtable thead th { background: var(--bg-deep); color: var(--muted); font-family: var(--font-ui); font-weight: 600; white-space: nowrap; }
  .coverage tbody th, .dtable tbody th { font-weight: 400; min-width: 15rem; max-width: 22rem; }
  .coverage tbody th strong { display: block; font-family: var(--font-ui); }
  .coverage tbody th span, .dtable tbody th span { display: block; margin-top: 0.2rem; color: var(--muted); font-size: 0.9rem; }
  .coverage ul, .dtable ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; }
  .coverage td { min-width: 12rem; }
  .coverage li, .dtable li { margin: 0; max-width: none; }
  .coverage__none { color: var(--muted); }
  .counters { display: flex; flex-wrap: wrap; gap: 0.6rem 2.8rem; list-style: none; padding: 0; margin: 2rem 0 0.9rem; max-width: none; }
  .counters-note { margin: 0 0 0.8rem; max-width: none; }
  .counted { margin: 0 0 3rem; font-family: var(--font-ui); }
  .counted summary { cursor: pointer; color: var(--muted); }
  .counted dl { display: grid; grid-template-columns: 7rem 1fr; gap: 0.5rem 1.2rem; margin: 0.8rem 0 0; }
  .counted dt { color: var(--muted); }
  .counted dd { margin: 0; }
  .counters li { margin: 0; display: grid; }
  .counters strong { font: 600 clamp(2.2rem, 5vw, 3.4rem)/1 var(--font-ui); font-variant-numeric: tabular-nums; }
  .counters span { color: var(--muted); font-family: var(--font-ui); font-size: 1.05rem; }
  .reports .row { grid-template-columns: 7rem 1fr; }
</style>
