---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import ItemMeta from '../../components/ItemMeta.astro';
import { posts, yearsOf } from '../../lib/posts';

const years = yearsOf(posts);
---

<Base title="Blog" description="Accounts of projects, results, courses, and milestones in computational pharmaceutics and formulation, one post for each.">
  <div class="page">
    <h1>Blog</h1>
    <p class="page__lede">One post for each project, result, course, and milestone, newest first. Posts are dated by the event they describe.</p>

    {years.map((y) => (
      <Section title={y} icon="calendar">
        <ul class="rows">
          {posts
            .filter((p) => p.date.startsWith(y))
            .map((p) => (
              <li class="row">
                <span class="row__when">{p.date}</span>
                <div class="row__body">
                  <h3><a href={`/blog/${p.slug}/`}>{p.title}</a></h3>
                  <p>{p.summary}</p>
                  <p class="meta"><ItemMeta kind={p.topic ?? 'post'} minutes={p.minutes} /></p>
                </div>
              </li>
            ))}
        </ul>
      </Section>
    ))}
  </div>
</Base>
