---
import Base from '../../layouts/Base.astro';
import PostMain from '../../components/PostMain.astro';
import Toc from '../../components/Toc.astro';
import ReportTools from '../../components/ReportTools.astro';
import EmbedTools from '../../components/EmbedTools.astro';
import { posts } from '../../lib/posts';

export function getStaticPaths() {
  const modules = import.meta.glob('../../content/blog/*.md', { eager: true }) as Record<string, any>;
  return Object.entries(modules)
    .filter(([, m]) => !m.frontmatter.draft)
    .map(([file, m]) => ({
      params: { slug: file.split('/').pop()!.replace(/\.md$/, '') },
      props: { post: m },
    }));
}

const { post } = Astro.props;
const { Content, frontmatter } = post;
const slug = Astro.params.slug;
const info = posts.find((p) => p.slug === slug)!;
const i = posts.findIndex((p) => p.slug === slug);
const newer = posts[i - 1];
const older = posts[i + 1];
// A post that mirrors a report (`report: true`, with its `sections`) gets the catalogue on the right and the tools of the report.
const isReport = frontmatter.report === true;
const toc: { id: string; label: string }[] = frontmatter.sections ?? [];
---

<Base title={frontmatter.title} description={frontmatter.summary}>
  {isReport ? (
    <Fragment>
      <div class="page page--toc">
        <article class="post post--report">
          <PostMain title={frontmatter.title} date={info.date} kind={info.topic ?? 'post'} minutes={info.minutes} newer={newer} older={older}>
            <Content />
          </PostMain>
        </article>
        <Toc items={toc} />
      </div>
      <ReportTools />
    </Fragment>
  ) : (
    <article class="page post">
      <PostMain title={frontmatter.title} date={info.date} kind={info.topic ?? 'post'} minutes={info.minutes} newer={newer} older={older}>
        <Content />
      </PostMain>
      {frontmatter.embed && <EmbedTools />}
    </article>
  )}
</Base>

<style is:global>
  .post-title { font-size: clamp(2rem, 4.2vw, 3rem); max-width: 26ch; }
  .prose p { margin: 0 0 1.1em; }
</style>
