---
// The chart of a validation report. The drawing is src/lib/charts.js, which the browser uses again when a reader changes a control of an interactive report.
import { chartSvg } from '../lib/charts.js';
import type { Chart } from '../data/reports';

interface Props {
  chart: Chart;
  alt: string;
}
const { chart, alt } = Astro.props;
---

<Fragment set:html={chartSvg(chart, alt)} />

<style is:global>
  .rchart { width: 100%; max-width: 44rem; height: auto; display: block; overflow: visible; }
  .rchart text { font-family: var(--font-ui); font-size: 13px; fill: var(--muted); }
  .rchart .lbl { fill: var(--text); font-size: 14px; }
  .rchart .val { fill: var(--text); font-size: 13px; font-variant-numeric: tabular-nums; }
  .rchart .grid { stroke: var(--rule); stroke-width: 1; }
  .rchart .refline { stroke: var(--muted); stroke-width: 1.2; stroke-dasharray: 4 4; }
  .rchart .refl { fill: var(--muted); font-size: 12px; paint-order: stroke; stroke: var(--bg); stroke-width: 3px; stroke-linejoin: round; }
  .rchart .bar { fill: var(--n); }
  .rchart .bar.neg { fill: var(--fe); }
  .rchart .dot-a { fill: var(--n); }
  .rchart .dot-b { fill: var(--fe); }
  .rchart .link { stroke: var(--muted); stroke-width: 1.5; stroke-dasharray: 3 3; }
  .rchart .ci { stroke: var(--n); stroke-width: 2; opacity: 0.55; }
  .rchart .refmark { fill: var(--fe); }
  .rchart .legend text { font-size: 13px; }
  .rchart .gate { fill: none; stroke: var(--rule); stroke-width: 1.5; }
  .rchart .gate.met { fill: var(--fe); stroke: var(--fe); }
  .rchart .gate.dim { opacity: 0.3; }
  .rchart .gate[data-tip]:hover, .rchart .gate[data-tip]:focus { stroke: var(--text); outline: none; }
  .rchart .hit { fill: transparent; }
  .rchart g[data-tip]:hover .hit, .rchart g[data-tip]:focus .hit { fill: color-mix(in srgb, var(--n) 10%, transparent); }
  .rchart g[data-tip]:focus { outline: none; }
  .rchart .curve { fill: none; stroke: var(--n); stroke-width: 2.2; }
  .rchart .hitdot { fill: transparent; }
  .rchart .hitdot:hover, .rchart .hitdot:focus { fill: color-mix(in srgb, var(--n) 35%, transparent); outline: none; }
  .rtip { position: fixed; z-index: 50; max-width: min(22rem, 90vw); padding: 0.45rem 0.7rem; color: var(--text); font: 0.9rem/1.35 var(--font-ui); background: var(--panel); border: 1px solid var(--rule); border-radius: 6px; box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25); pointer-events: none; }
</style>
