---
import Icon from './Icon.astro';
import { profiles } from '../data/site';

interface Props {
  /** "row" wraps the links horizontally; "list" stacks them like a profile card. */
  layout?: 'row' | 'list';
}
const { layout = 'row' } = Astro.props;
const items = profiles;
---

<ul class={`iconlinks iconlinks--${layout}`}>
  {items.map((i) => (
    <li>
      <a class="iconlink" href={i.href} title={i.label} aria-label={i.label} rel={i.icon === 'mail' ? undefined : 'me noopener'}>
        <Icon name={i.icon} />
        {layout === 'list' && <span>{i.label}</span>}
      </a>
    </li>
  ))}
</ul>

<style is:global>
  /* in a row the icon is enough: the name is in the tooltip and in the accessible label */
  .iconlinks--row .iconlink { padding: 0.7rem; }
  .iconlinks--row .icon { width: 1.7rem; height: 1.7rem; }
  .iconlinks--list { flex-direction: column; flex-wrap: nowrap; gap: 0.15rem; margin: 0; }
  .iconlinks--list .iconlink { border: 0; padding: 0.35rem 0; border-radius: 0; gap: 0.7rem; }
  .iconlinks--list .iconlink:hover { transform: translateX(3px); }
  .iconlinks--list .icon { width: 1.35rem; height: 1.35rem; }
  .iconlink .icon--mail, .iconlink .icon--pin { color: var(--muted) !important; }
</style>
